---
import "../styles/global.css";
import LoginForm from "../components/LoginForm.astro";
import MfaModal from "../components/MfaModal.astro";
import FolderBar from "../components/FolderBar.astro";
import CourseToolbar from "../components/CourseToolbar.astro";
import CourseTree from "../components/CourseTree.astro";
import ActionFooter from "../components/ActionFooter.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>IDAT Sync</title>
  </head>
  <body class="bg-slate-100 text-slate-900 antialiased">
    <LoginForm />
    <MfaModal />

    <main id="sync-view" class="hidden h-screen flex-col">
      <FolderBar />
      <CourseToolbar />
      <CourseTree />
      <ActionFooter />
    </main>

    <script>
      const $ = (id) => document.getElementById(id);

      const loginView = $("login-view");
      const syncView = $("sync-view");
      const loginForm = $("login-form");
      const usernameInput = $("username");
      const passwordInput = $("password");
      const loginBtn = $("login-btn");
      const loginError = $("login-error");

      const mfaModal = $("mfa-modal");
      const mfaForm = $("mfa-form");
      const mfaInput = $("mfa-code");
      const mfaCancelBtn = $("mfa-cancel-btn");

      const folderPathEl = $("folder-path");
      const browseBtn = $("browse-btn");
      const btnInProgress = $("btn-in-progress");
      const btnSelectAll = $("btn-select-all");
      const btnClear = $("btn-clear");
      const treeBody = $("course-tree-body");
      const statusText = $("status-text");
      const logoutBtn = $("logout-btn");
      const syncBtn = $("sync-btn");

      let currentState = { view: "login", is_login: false, mfa_open: false };
      let wasMfaOpen = false;
      const openOverrides = new Map();

      function api() {
        return window.pywebview && window.pywebview.api ? window.pywebview.api : null;
      }

      function callApi(method, ...args) {
        const bridge = api();
        if (bridge && typeof bridge[method] === "function") {
          return Promise.resolve(bridge[method](...args));
        }
        return Promise.resolve();
      }

      function updateLoginButton() {
        const isLogin = Boolean(currentState.is_login);
        const hasCreds = usernameInput.value.trim().length > 0 && passwordInput.value.length > 0;
        loginBtn.disabled = isLogin || !hasCreds;
        loginBtn.textContent = isLogin ? "Signing in..." : "Login";
        usernameInput.disabled = isLogin;
        passwordInput.disabled = isLogin;
      }

      function badgeClass(status) {
        switch ((status || "").toLowerCase()) {
          case "synced":
          case "completed":
          case "done":
            return "bg-emerald-50 text-emerald-700 ring-emerald-200";
          case "downloading":
          case "fetching":
          case "fetching contents...":
          case "fetching & syncing":
          case "syncing":
            return "bg-blue-50 text-blue-700 ring-blue-200";
          case "failed":
          case "error":
            return "bg-red-50 text-red-700 ring-red-200";
          case "queued":
          case "pending":
            return "bg-amber-50 text-amber-700 ring-amber-200";
          default:
            return "bg-slate-100 text-slate-600 ring-slate-200";
        }
      }

      function isNodeOpen(node) {
        if (openOverrides.has(node.id)) return openOverrides.get(node.id);
        return Boolean(node.open);
      }

      function renderTree(courses, isSyncing) {
        treeBody.replaceChildren();
        if (!courses || courses.length === 0) {
          const empty = document.createElement("div");
          empty.className = "px-4 py-8 text-center text-sm text-slate-400";
          empty.textContent = "No courses loaded.";
          treeBody.appendChild(empty);
          return;
        }

        const frag = document.createDocumentFragment();

        function appendNode(node, depth) {
          const children = Array.isArray(node.children) ? node.children : [];
          const hasChildren = children.length > 0;
          const open = hasChildren && isNodeOpen(node);

          const row = document.createElement("div");
          row.className =
            "grid grid-cols-[1fr_9.5rem_4.5rem] items-center px-4 py-2 hover:bg-slate-50";

          const left = document.createElement("div");
          left.className = "flex min-w-0 items-center gap-2";
          left.style.paddingLeft = `${depth * 1.25}rem`;

          if (hasChildren) {
            const toggle = document.createElement("button");
            toggle.type = "button";
            toggle.className =
              "flex h-5 w-5 shrink-0 items-center justify-center rounded text-xs text-slate-500 hover:bg-slate-200";
            toggle.textContent = open ? "▾" : "▸";
            toggle.setAttribute("aria-label", open ? "Collapse" : "Expand");
            toggle.addEventListener("click", () => {
              openOverrides.set(node.id, !open);
              renderTree(currentState.courses || [], Boolean(currentState.is_syncing));
            });
            left.appendChild(toggle);
          } else {
            const spacer = document.createElement("span");
            spacer.className = "inline-block h-5 w-5 shrink-0";
            left.appendChild(spacer);
          }

          if (depth === 0) {
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = Boolean(node.checked);
            checkbox.disabled = isSyncing;
            checkbox.className =
              "h-4 w-4 shrink-0 rounded border-slate-300 text-blue-600 focus:ring-blue-500 disabled:opacity-50";
            checkbox.addEventListener("change", () => callApi("toggle_course", node.id));
            left.appendChild(checkbox);
          }

          const label = document.createElement("span");
          label.className =
            depth === 0
              ? "truncate font-medium text-slate-800"
              : hasChildren
                ? "truncate font-medium text-slate-700"
                : "truncate text-slate-600";
          label.textContent = node.name || "";
          label.title = node.name || "";
          left.appendChild(label);

          const statusWrap = document.createElement("div");
          if (node.status) {
            const badge = document.createElement("span");
            badge.className = `inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${badgeClass(node.status)}`;
            badge.textContent = node.status;
            statusWrap.appendChild(badge);
          }

          const progress = document.createElement("span");
          progress.className = "text-right font-mono text-xs text-slate-500";
          progress.textContent = node.progress || "";

          row.append(left, statusWrap, progress);
          frag.appendChild(row);

          if (open) {
            for (const child of children) {
              appendNode(child, depth + 1);
            }
          }
        }

        for (const course of courses) {
          appendNode(course, 0);
        }
        treeBody.appendChild(frag);
      }

      window.__onPythonState = function onPythonState(state) {
        if (!state || typeof state !== "object") return;
        currentState = state;

        const isSyncView = state.view === "sync";
        loginView.classList.toggle("hidden", isSyncView);
        syncView.classList.toggle("hidden", !isSyncView);
        syncView.classList.toggle("flex", isSyncView);

        if (!isSyncView) {
          if (typeof state.username === "string" && document.activeElement !== usernameInput) {
            usernameInput.value = state.username;
          }
          const err = state.error || "";
          loginError.textContent = err;
          loginError.classList.toggle("hidden", !err);
          updateLoginButton();

          const mfaOpen = Boolean(state.mfa_open);
          mfaModal.classList.toggle("hidden", !mfaOpen);
          mfaModal.classList.toggle("flex", mfaOpen);
          if (mfaOpen && !wasMfaOpen) {
            mfaInput.value = "";
            mfaInput.focus();
          }
          wasMfaOpen = mfaOpen;
          return;
        }

        mfaModal.classList.add("hidden");
        mfaModal.classList.remove("flex");
        wasMfaOpen = false;

        const isSyncing = Boolean(state.is_syncing);
        folderPathEl.textContent = state.folder_path || "No folder selected";
        folderPathEl.title = state.folder_path || "";

        browseBtn.disabled = isSyncing;
        btnInProgress.disabled = isSyncing;
        btnSelectAll.disabled = isSyncing;
        btnClear.disabled = isSyncing;
        logoutBtn.disabled = isSyncing;
        syncBtn.disabled = isSyncing || !state.can_sync;
        syncBtn.textContent = isSyncing ? "Syncing..." : "Sync";

        statusText.textContent = state.status || "";
        statusText.title = state.status || "";
        renderTree(state.courses || [], isSyncing);
      };

      usernameInput.addEventListener("input", updateLoginButton);
      passwordInput.addEventListener("input", updateLoginButton);

      loginForm.addEventListener("submit", (event) => {
        event.preventDefault();
        if (loginBtn.disabled) return;
        callApi("login", usernameInput.value, passwordInput.value);
      });

      mfaForm.addEventListener("submit", (event) => {
        event.preventDefault();
        callApi("submit_mfa", mfaInput.value.trim());
      });

      mfaCancelBtn.addEventListener("click", () => callApi("cancel_mfa"));
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && currentState.mfa_open) {
          callApi("cancel_mfa");
        }
      });

      browseBtn.addEventListener("click", () => callApi("browse_folder"));
      btnInProgress.addEventListener("click", () => callApi("select_in_progress"));
      btnSelectAll.addEventListener("click", () => callApi("select_all"));
      btnClear.addEventListener("click", () => callApi("clear_selection"));
      logoutBtn.addEventListener("click", () => callApi("logout"));
      syncBtn.addEventListener("click", () => callApi("sync"));

      function hydrate() {
        callApi("get_state").then((state) => {
          if (state) window.__onPythonState(state);
        });
      }

      window.addEventListener("pywebviewready", hydrate);
      if (api()) hydrate();
    </script>
  </body>
</html>
