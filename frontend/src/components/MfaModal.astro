---
---

<div
  id="mfa-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mfa-title"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4"
>
  <div class="w-full max-w-xs rounded-xl border border-slate-200 bg-white p-6 shadow-lg">
    <h2 id="mfa-title" class="text-base font-semibold text-slate-900">
      Verification Code
    </h2>
    <p class="mt-1 text-sm text-slate-500">
      Enter the 6-digit MFA code sent to your device.
    </p>

    <form id="mfa-form" class="mt-4 space-y-4">
      <input
        id="mfa-code"
        name="mfa_code"
        type="text"
        inputmode="numeric"
        autocomplete="one-time-code"
        maxlength="6"
        placeholder="000000"
        class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-center font-mono text-lg tracking-widest text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
      />

      <div class="flex justify-end gap-2">
        <button
          id="mfa-cancel-btn"
          type="button"
          class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          Cancel
        </button>
        <button
          id="mfa-submit-btn"
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-blue-700"
        >
          Verify
        </button>
      </div>
    </form>
  </div>
</div>
