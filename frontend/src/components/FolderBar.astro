<div class="flex items-center gap-2 border-b border-slate-200 bg-white px-4 py-3">
  <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-slate-500">
    Folder
  </span>
  <div
    id="folder-path"
    class="min-w-0 flex-1 truncate rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-700"
  >
    No folder selected
  </div>
  <button
    id="browse-btn"
    type="button"
    class="shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
  >
    Browse...
  </button>
</div>
