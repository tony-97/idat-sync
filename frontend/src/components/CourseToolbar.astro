<div class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-slate-50 px-4 py-2">
  <span class="mr-auto text-xs font-medium uppercase tracking-wide text-slate-500">
    Courses
  </span>
  <button
    id="btn-in-progress"
    type="button"
    class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50"
  >
    In Progress
  </button>
  <button
    id="btn-select-all"
    type="button"
    class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50"
  >
    Select All
  </button>
  <button
    id="btn-clear"
    type="button"
    class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50"
  >
    Clear
  </button>
</div>
